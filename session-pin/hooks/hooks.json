{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session-pin.py\" prompt 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session-pin.py\" prompt 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session-pin.py\" stop 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session-pin.py\" stop 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session-pin.py\" end 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session-pin.py\" end 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
